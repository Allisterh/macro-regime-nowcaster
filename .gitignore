# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files
.env
.env.local

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files
# Anchored with a leading slash: a bare `data/` matches a directory of
# that name at ANY depth, which silently excluded src/data/ — the whole
# data layer — from version control.
/data/
*.db
*.duckdb
*.parquet
*.csv
*.feather

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log

# Model artifacts
# Anchored for the same reason: a bare `models/` excluded src/models/,
# which is the DFM, Kalman filter, regime-switching model, probit,
# backtester and nowcaster — the core of the project.
/models/
*.pkl
*.joblib
